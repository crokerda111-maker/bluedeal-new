# Optional: verified Coupang Partners tracking value
# 링크 변환 규칙은 파트너 계정에서 발급·확인한 값만 사용하세요.
# COUPANG_LPTAG=YOUR_TAG_HERE

# Required for the PC price collector / trusted import jobs.
# Generate a random value with at least 24 characters and send it as:
# Authorization: Bearer <OUTBOUND_INGEST_SECRET>
# OUTBOUND_INGEST_SECRET=replace-with-a-long-random-secret

# Price data is generated by ops/collector and committed with the site.
# No VPS or price API environment variable is required.

# Online posts storage (recommended: Vercel KV / Upstash Redis REST)
# - You can use either KV_* vars (Vercel KV) or UPSTASH_* vars (Upstash)
# KV_REST_API_URL=https://<your-upstash-endpoint>
# KV_REST_API_TOKEN=<your-token>
# UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>
# UPSTASH_REDIS_REST_TOKEN=<your-token>

# Admin password (for /admin)
# ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Enable member login first, then require it for public writing after verification.
# BLUEDEAL_GOOGLE_MEMBER_LOGIN=0
# Register https://bluedeal.co.kr/api/member/google/callback as the exact redirect URI.
# BLUEDEAL_GOOGLE_WRITE_LOGIN=0
# BLUEDEAL_GOOGLE_CLIENT_ID=<google-oauth-web-client-id>
# BLUEDEAL_GOOGLE_CLIENT_SECRET=<google-oauth-web-client-secret>
# BLUEDEAL_MEMBER_KEY=<stable-32-byte-secret-in-hex>
