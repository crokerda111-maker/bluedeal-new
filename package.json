{
  "name": "bluedeal-mvp",
  "version": "0.3.59",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "test:boards": "node ops/tests/board-smoke.mjs",
    "test:prices": "node --experimental-strip-types --test ops/tests/price-data.mjs",
    "test:affiliate": "node --experimental-strip-types --test ops/tests/affiliate.mjs",
    "test:post-client": "node --experimental-strip-types --test ops/tests/post-client.mjs",
    "test:links": "node --experimental-strip-types --test ops/tests/text-links.mjs",
    "test:profile": "node --experimental-strip-types --test ops/tests/profile.mjs",
    "test:dates": "node --experimental-strip-types --test ops/tests/date-format.mjs",
    "test:snapshot": "node --experimental-strip-types --test ops/tests/price-snapshot.mjs",
    "test:collector": "python -m unittest discover -s ops/tests -p test_collector.py",
    "test:hotdeals": "python -m unittest discover -s ops/tests -p test_hotdeals.py",
    "test:assessment": "node --experimental-strip-types --test ops/tests/value-assessment.mjs",
    "test:catalog": "node --experimental-strip-types --test ops/tests/product-catalog.mjs",
    "test:price-catalog": "node ops/tests/price-catalog-http.mjs",
    "test:ops": "python -m unittest discover -s ops/tests -p test_*.py"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.17",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
